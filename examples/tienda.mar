// ============================================================================
// TIENDA — un marketplace tipo Mercado Libre, escrito entero en Marea.
//
// Es el ejemplo grande del repositorio: sirve para ver el lenguaje resolviendo
// una app real (catálogo, búsqueda, filtros, orden, carrito, compra con
// descuento de stock, preguntas y reseñas) y para que los límites se noten.
//
// Tres rodeos que el lenguaje obliga a dar hoy, marcados donde aparecen:
//   (1) No hay bucles -> todo recorrido es recursión con índice.
//   (2) No hay genéricos ni cierres -> cada recorrido se escribe entero.
//
// Construir y correr:
//   marea build-app examples/tienda.mar /tmp/tienda
//   node /tmp/tienda/serve.ts
// ============================================================================

// Cada entidad tiene su propio tipo y su propio almacén: tablas (o archivos)
// distintos, sin campos de relleno ni discriminadores.
type Producto = {
    titulo: String,
    categoria: String,
    precio: Int,           // centavos: el dinero nunca en Float
    descuento: Int,        // porcentaje 0..90
    stock: Int,
    vendedor: String,
    reputacion: Int,       // 0..5
    envioGratis: Bool,
    vendidos: Int
};

type Orden = { titulo: String, comprador: String, cantidad: Int, total: Int, refIdx: Int };
type Pregunta = { quien: String, texto: String, refIdx: Int };
type Resena = { quien: String, texto: String, estrellas: Int, refIdx: Int };

store productos: Producto;
store ordenes: Orden;
store preguntas: Pregunta;
store resenas: Resena;

// --------------------------------------------------------------------------
// Servidor
// --------------------------------------------------------------------------

@server
fn publicar(titulo: String, categoria: String, precio: Int, descuento: Int,
            stock: Int, vendedor: String, reputacion: Int, envioGratis: Bool) {
    save(productos, Producto {
        titulo: titulo, categoria: categoria, precio: precio,
        descuento: descuento, stock: stock, vendedor: vendedor,
        reputacion: reputacion, envioGratis: envioGratis, vendidos: 0
    });
}

@server
fn catalogo() -> List<Producto> {
    return all(productos);
}

// Búsqueda por texto + categoría + tope de precio, devuelta como DATOS.
@server
fn buscar(q: String, cat: String, tope: Int, soloGratis: Bool, i: Int) -> List<Producto> {
    let ps = all(productos);
    if i < len(ps) {
        let p = ps[i];
        let resto = buscar(q, cat, tope, soloGratis, i + 1);
        if coincide(p, q, cat, tope, soloGratis) {
            return concat([p], resto);
        }
        return resto;
    }
    return [];
}

fn coincide(p: Producto, q: String, cat: String, tope: Int, soloGratis: Bool) -> Bool {
    if q != "" {
        if !contains(lower(p.titulo), lower(q)) { return false; }
    }
    if cat != "" {
        if p.categoria != cat { return false; }
    }
    if tope > 0 {
        if precioFinal(p) > tope { return false; }
    }
    if soloGratis {
        if !p.envioGratis { return false; }
    }
    return true;
}

fn precioFinal(p: Producto) -> Int {
    if p.descuento > 0 {
        return p.precio - (p.precio * p.descuento / 100);
    }
    return p.precio;
}

// Compra: valida stock y cantidad, descuenta y registra la orden en SU almacén.
@server
fn comprar(idx: Int, quien: String, cantidad: Int) -> Int {
    let ps = all(productos);
    if idx < 0 { return 0; }
    if idx < len(ps) {
        let p = ps[idx];
        if cantidad > 0 {
            if p.stock >= cantidad {
                let total = precioFinal(p) * cantidad;
                update(productos, idx, Producto {
                    titulo: p.titulo, categoria: p.categoria, precio: p.precio,
                    descuento: p.descuento, stock: p.stock - cantidad,
                    vendedor: p.vendedor, reputacion: p.reputacion,
                    envioGratis: p.envioGratis, vendidos: p.vendidos + cantidad
                });
                save(ordenes, Orden {
                    titulo: p.titulo, comprador: quien,
                    cantidad: cantidad, total: total, refIdx: idx
                });
                return total;
            }
        }
    }
    return 0;
}

@server
fn ventas() -> List<Orden> {
    return all(ordenes);
}

@server
fn calificar(idx: Int, quien: String, estrellas: Int, texto: String) {
    if estrellas > 0 {
        if estrellas < 6 {
            save(resenas, Resena {
                quien: quien, texto: texto, estrellas: estrellas, refIdx: idx
            });
        }
    }
}

// Promedio de estrellas de un producto: recorre SOLO el almacén de reseñas.
@server
fn calificacion(idx: Int) -> Int {
    let rs = all(resenas);
    return promedio(rs, 0, idx, 0, 0);
}

fn promedio(rs: List<Resena>, i: Int, idx: Int, suma: Int, cuenta: Int) -> Int {
    if i < len(rs) {
        let r = rs[i];
        if r.refIdx == idx {
            return promedio(rs, i + 1, idx, suma + r.estrellas, cuenta + 1);
        }
        return promedio(rs, i + 1, idx, suma, cuenta);
    }
    if cuenta < 1 { return 0; }
    return suma / cuenta;
}

@server
fn preguntar(idx: Int, quien: String, texto: String) {
    save(preguntas, Pregunta { quien: quien, texto: texto, refIdx: idx });
}

@server
fn preguntasDe(idx: Int, i: Int) -> List<Pregunta> {
    let qs = all(preguntas);
    if i < len(qs) {
        let q = qs[i];
        let resto = preguntasDe(idx, i + 1);
        if q.refIdx == idx { return concat([q], resto); }
        return resto;
    }
    return [];
}

// --------------------------------------------------------------------------
// Estado reactivo del cliente
// --------------------------------------------------------------------------

reactive mut resultados = [];
reactive mut consulta = "";
reactive mut categoria = "";
reactive mut soloGratis = false;
reactive mut carritoCant = 0;
reactive mut carritoTotal = 0;
reactive mut aviso = "";

// --------------------------------------------------------------------------
// Dinero: centavos -> "$24.999,00" con separadores es-MX.
// --------------------------------------------------------------------------

fn dos(n: Int) -> Html {
    if n < 10 { return concat("0", text(n)); }
    return text(n);
}

fn tres(n: Int) -> Html {
    if n < 10 { return concat("00", text(n)); }
    if n < 100 { return concat("0", text(n)); }
    return text(n);
}

fn miles(n: Int) -> Html {
    if n < 1000 { return text(n); }
    return concat(miles(n / 1000), concat(",", tres(n % 1000)));
}

fn dinero(centavos: Int) -> Html {
    return concat("$", concat(miles(centavos / 100), concat(".", dos(centavos % 100))));
}

// --------------------------------------------------------------------------
// Pintado (rodeo 2: recursión con índice)
// --------------------------------------------------------------------------

fn estrellitas(n: Int) -> Html {
    if n < 1 { return ""; }
    return concat("★", estrellitas(n - 1));
}

fn insignia(p: Producto) -> Html {
    if p.envioGratis {
        return `<span class="envio">Envío gratis</span>`;
    }
    return ``;
}

fn etiquetaStock(s: Int) -> Html {
    if s < 1 { return `<span class="agotado">Sin stock</span>`; }
    if s < 5 { return `<span class="pocas">¡Últimas {text(s)} disponibles!</span>`; }
    return `<span class="hay">{text(s)} disponibles</span>`;
}

fn precioBloque(p: Producto) -> Html {
    if p.descuento > 0 {
        return `<p class="antes">{!dinero(p.precio)}</p>
        <p class="precio">{!dinero(precioFinal(p))}<span class="off">{text(p.descuento)}% OFF</span></p>`;
    }
    return `<p class="precio">{!dinero(p.precio)}</p>`;
}

// Con plantillas, la tarjeta se lee de un vistazo. Los datos del store van en
// huecos normales, así que se escapan solos: olvidarse ya no es posible.
fn tarjeta(p: Producto, idx: Int) -> Html {
    return `<li class="card">
  <h3>{p.titulo}</h3>
  {!precioBloque(p)}
  <p class="vend">{p.vendedor} {!estrellitas(p.reputacion)} {!insignia(p)}</p>
  <p class="st">{!etiquetaStock(p.stock)}</p>
  <button onclick="marea.agregarAlCarrito({text(idx)})">Agregar al carrito</button>
</li>`;
}

fn tarjetas(xs: List<Producto>, i: Int) -> Html {
    if i < len(xs) {
        return concat(tarjeta(xs[i], i), tarjetas(xs, i + 1));
    }
    return "";
}

@client
fn vista() -> Html {
    let xs = resultados;
    let n = len(xs);
    return concat(
        concat(
            concat("<p class=\"aviso\">", concat(escape(aviso), "</p>")),
            concat(
                concat("<p class=\"cuenta\">", text(n)),
                concat(" resultados · carrito: ", concat(text(carritoCant),
                    concat(" (", concat(dinero(carritoTotal), ")</p>"))))
            )
        ),
        concat("<ul class=\"grid\">", concat(tarjetas(xs, 0), "</ul>"))
    );
}

@client
fn refrescar() {
    resultados = buscar(consulta, categoria, 0, soloGratis, 0);
}

@client
fn buscarTexto(q: String) {
    consulta = q;
    refrescar();
}

@client
fn filtrarCategoria(c: String) {
    categoria = c;
    refrescar();
}

@client
fn agregarAlCarrito(i: Int) {
    let xs = resultados;
    if i < len(xs) {
        let p = xs[i];
        if p.stock > 0 {
            carritoCant = carritoCant + 1;
            carritoTotal = carritoTotal + precioFinal(p);
            aviso = concat("Agregado: ", escape(p.titulo));
        } else {
            aviso = "Ese producto está sin stock";
        }
    }
}

@client
fn main() {
    publicar("iPhone 15 Pro Max 256GB", "celulares", 2499900, 10, 8, "TiendaMovil", 5, true);
    publicar("Samsung Galaxy S24 Ultra", "celulares", 2199900, 0, 3, "MundoTech", 4, true);
    publicar("Funda para iPhone 15", "accesorios", 29900, 20, 50, "AccesoriosMX", 3, false);
    publicar("Laptop Gamer RTX 4060", "computo", 3299900, 15, 2, "PCStore", 5, true);
    publicar("Teclado mecánico RGB", "computo", 89900, 0, 0, "PCStore", 5, false);
    publicar("Audífonos Bluetooth ANC", "audio", 149900, 25, 25, "AudioMax", 4, true);
    calificar(0, "ana", 5, "Excelente, llegó en dos días");
    calificar(0, "luis", 4, "Muy bueno el equipo");
    preguntar(0, "carlos", "¿Incluye cargador?");
    refrescar();
}
