// La frontera de red como primitiva del lenguaje.
//
// 'getUser' lleva @server: corre en el servidor. Desde @client se llama como
// si fuera local — el compilador generará el RPC, la serialización y la
// validación del límite. No hay "capa de API" que escribir a mano.

type UserId = Int;
type User = Record;

@server
fn getUser(id: UserId) -> User | NotFound {
    let usuario = db.users.find(id);
    return usuario;
}

@client
fn perfil(id: UserId) {
    // El cruce de la frontera es asíncrono, así que se hace en el cuerpo de la
    // función y no en el inicializador de una 'reactive' (que se compila a un
    // memo síncrono: no habría dónde esperar la respuesta).
    let usuario = getUser(id);

    // El retorno es una unión opaca: no se puede leer '.nombre' sin pasar por
    // un 'match', que estrecha cada rama a su variante.
    match usuario {
        NotFound => render("Usuario no encontrado"),
        _ => render(usuario.nombre),
    }
}
