// DEBE FALLAR: E_NON_EXHAUSTIVE_MATCH (y E_FIELD_ON_UNION dentro de la rama)
//
// 'buscar' devuelve la unión 'User | NotFound'. El 'match' sólo cubre la
// variante NotFound y no tiene comodín, así que falta la variante User: el
// verificador lo reporta como no exhaustivo.

type User = { nombre: String };

store User;

@server
fn buscar(id: Int) -> User | NotFound {
    let usuarios = todos();
    if id < len(usuarios) {
        return usuarios[id];
    }
    return NotFound;
}

@client
fn ver(id: Int) {
    let usuario = buscar(id);

    match usuario {
        NotFound => render("no encontrado"),
    }
}
